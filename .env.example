# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Optional model overrides
CLAUDE_MODEL_SMART=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# The Muse public API key (optional; raises rate limit)
MUSE_API_KEY=

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Comma-separated emails allowed to sign up (leave empty to allow anyone)
ALLOWED_EMAILS=

# How many top new matches get a tailored resume automatically per scan
AUTO_TAILOR_MAX=12
